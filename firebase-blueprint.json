{
  "entities": {
    "LeaderboardEntry": {
      "title": "LeaderboardEntry",
      "description": "High score racing record submitted by players",
      "type": "object",
      "properties": {
        "playerName": { "type": "string" },
        "score": { "type": "number" },
        "distance": { "type": "number" },
        "topSpeed": { "type": "number" },
        "carName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["playerName", "score", "distance", "topSpeed", "carName", "createdAt"]
    }
  },
  "firestore": {
    "/leaderboard/{scoreId}": {
      "schema": "LeaderboardEntry",
      "description": "Global leaderboard rankings"
    }
  }
}
