rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLeaderboardEntry(data) {
      return data.keys().hasAll(['playerName', 'score', 'distance', 'topSpeed', 'carName', 'createdAt']) &&
        data.keys().hasOnly(['playerName', 'score', 'distance', 'topSpeed', 'carName', 'createdAt']) &&
        data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 64 &&
        data.carName is string && data.carName.size() >= 1 && data.carName.size() <= 64 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        data.score is number && data.score >= 0 && data.score <= 100000000 &&
        data.distance is number && data.distance >= 0 && data.distance <= 10000000 &&
        data.topSpeed is number && data.topSpeed >= 0 && data.topSpeed <= 2000;
    }

    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    match /leaderboard/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) && isValidLeaderboardEntry(request.resource.data);
      allow update, delete: if false;
    }
  }
}
